# Required application configuration
DATABASE_URL=postgresql://apexcredit_user:replace-me@localhost:5432/apexcredit
DATABASE_POOL_MAX=10
PORT=3000
HOST=127.0.0.1

# Local development only. Never enable this in production.
AUTH_DISABLED_FOR_LOCAL_DEV=true

# Production authentication uses an OIDC provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BASE_URL=https://your-application-host
SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_ROLE_CLAIM=roles
TRUST_PROXY=false

# Optional provider credentials. Credentials alone do not enable a connector;
# provider-specific implementations and health checks still need to be added.
COMPANY_REGISTRY_BASE_URL=
COMPANY_REGISTRY_API_KEY=
CREDIT_BUREAU_BASE_URL=
CREDIT_BUREAU_API_KEY=
SCREENING_BASE_URL=
SCREENING_API_KEY=
DOCUMENT_STORAGE_BASE_URL=
DOCUMENT_STORAGE_CLIENT_SECRET=
CREDIT_GATEWAY_BASE_URL=
CREDIT_GATEWAY_CLIENT_SECRET=

# Optional AI-assisted drafting. If missing or unavailable, draft APIs fail
# closed and do not return canned/sample financial or compliance text.
GEMINI_API_KEY=

# Optional Python executable override (Windows default: python; Unix default: python3).
PYTHON_EXECUTABLE=
